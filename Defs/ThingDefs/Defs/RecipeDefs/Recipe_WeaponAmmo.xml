<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 狙击榴弹发射器 制造配方（材料昂贵，制作工时改为850） -->
  <RecipeDef Name="Recipe_SnipeGrenadeLauncher" Class="RecipeDef">
    <label>制作狙击榴弹发射器</label>
    <description>在机械加工台制作狙击榴弹发射器。</description>
    <jobMaker>
      <job>MakeSomething</job>
    </jobMaker>
    <ingredients>
      <li>
        <thingDef>Steel</thingDef>
        <count>100</count>
      </li>
      <li>
        <thingDef>ComponentIndustrial</thingDef>
        <count>12</count>
      </li>
      <li>
        <thingDef>Plasteel</thingDef>
        <count>30</count>
      </li>
    </ingredients>
    <products>
      <li>
        <thingDef>SnipeGrenadeLauncher</thingDef>
        <count>1</count>
      </li>
    </products>
    <workSpeedStat>CraftingSpeed</workSpeedStat>
    <workAmount>850</workAmount>
    <skillRequirements>
      <Crafting>9</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
  </RecipeDef>

  <!-- 35mm狙击榴弹 制造配方，保留截图原版 -->
  <RecipeDef Name="Recipe_SnipeGrenadeShell" Class="RecipeDef">
    <label>制作35mm狙击榴弹</label>
    <description>加工台制作35mm高爆榴弹。</description>
    <jobMaker>
      <job>MakeSomething</job>
    </jobMaker>
    <ingredients>
      <li>
        <thingDef>Steel</thingDef>
        <count>15</count>
      </li>
      <li>
        <thingDef>Chemfuel</thingDef>
        <count>15</count>
      </li>
    </ingredients>
    <products>
      <li>
        <thingDef>SnipeGrenadeShell</thingDef>
        <count>1</count>
      </li>
    </products>
    <workSpeedStat>CraftingSpeed</workSpeedStat>
    <workAmount>320</workAmount>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
  </RecipeDef>
</Defs>
